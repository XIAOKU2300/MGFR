__pycache__/
*.py[cod]
*.so
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# --- Unity (applies once unity-client/ holds a real project) ---------------
/unity-client/**/[Ll]ibrary/
/unity-client/**/[Tt]emp/
/unity-client/**/[Oo]bj/
/unity-client/**/[Bb]uild/
/unity-client/**/[Bb]uilds/
/unity-client/**/[Ll]ogs/
/unity-client/**/[Uu]ser[Ss]ettings/
/unity-client/**/[Mm]emoryCaptures/
/unity-client/**/[Rr]ecordings/
/unity-client/**/.vs/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.opendb
*.VC.db
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app
/unity-client/**/[Aa]ssets/[Aa]ssetStore*/
/unity-client/**/[Ee]xportedObj/
/unity-client/**/[Cc]rashlytics/
/unity-client/**/*.pidb.meta
/unity-client/**/*.pdb.meta
/unity-client/**/*.mdb.meta
/unity-client/**/.utmp/
# Packages/packages-lock.json and every .meta file ARE committed on purpose.
# The lock file is what makes a resolved package set reproducible, and Unity
# regenerates a missing .meta with a fresh GUID, which silently breaks every
# reference to that asset.

# --- Editors / OS ----------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini
*.tmp
*.log

# --- Unity Hub and the editor are installed INSIDE this repo ---------------
# Hub's install root was pointed at H:\MGFR, so the editor lives at
# H:\MGFR\Editor and the Hub application at H:\MGFR\Unity Hub. Together that is
# roughly 49,000 files of tooling. They are not project content and must never
# be staged: a single `git add -A` would otherwise commit a whole Unity
# installation. Ignoring them is the entire fix. Moving them is not necessary,
# and it would break the install path the Hub has registered.
/Editor/
/Unity Hub/
/metadata.hub.json
/modules.json

